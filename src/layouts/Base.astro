---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, NAV, SOCIALS } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;

// Absolute canonical URL for this page (uses configured `site`).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// JSON-LD Person schema — gives search engines + AI answer engines a structured,
// authoritative profile to cite when people look for an AI engineer / strategist.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: Astro.site?.href,
  image: new URL(SITE.avatarFallback, Astro.site).href,
  jobTitle: 'AI Engineer & Digital Transformation Lead',
  description:
    'AI engineer and strategist building production LLM applications and autonomous agents — leading AI & digital transformation in the superyacht industry.',
  worksFor: {
    '@type': 'Organization',
    name: 'Cecil Wright & Partners',
    url: 'https://www.cecilwright.com',
    description: 'Boutique superyacht brokerage',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Bristol',
  },
  knowsAbout: [
    'Artificial Intelligence',
    'AI Engineering',
    'Large Language Models',
    'LLM Applications',
    'AI Agents',
    'AI Strategy',
    'Machine Learning',
    'Reinforcement Learning',
    'Superyacht Technology',
    'Digital Transformation',
    'Full-Stack Software Engineering',
    'Python',
    'TypeScript',
  ],
  knowsLanguage: 'en',
  sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// terminal title bar path, e.g. ~/work
const termPath =
  path === '/' ? '~' : `~${path.replace(/\/$/, '')}`;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@joshuacarey_" />
    <meta name="generator" content={Astro.generator} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
    <!-- AI answer engines & agents: see /agents.txt and /llms.txt -->
    <link rel="llms" href="/llms.txt" />
    <!-- Resolve theme before paint: explicit stored pref wins; otherwise
         desktop follows system, but PHONES default to light (the terminal is a
         desktop-first experience). If dark, add `preboot` so an opaque CRT cover
         paints BEFORE the terminal is visible; JS runs the boot then clears it. -->
    <script is:inline>
      window.__resolveTheme = function () {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') return t;
        // No explicit choice: small / coarse-pointer devices → light.
        var phone =
          window.matchMedia('(max-width: 640px)').matches ||
          window.matchMedia('(pointer: coarse)').matches;
        if (phone) return 'light';
        return window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      };
      (function () {
        try {
          var t = window.__resolveTheme();
          document.documentElement.setAttribute('data-theme', t);
          if (t === 'dark' && !sessionStorage.getItem('booted')) {
            document.documentElement.classList.add('preboot');
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', () => {
        try {
          document.documentElement.setAttribute('data-theme', window.__resolveTheme());
        } catch (e) {}
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="term-window">
      <div class="term-titlebar">
        <span class="term-dots" aria-hidden="true"
          ><span></span><span></span><span></span></span
        >
        <span class="term-title" aria-hidden="true"
          >{SITE.handle}@web: {termPath} — zsh</span
        >
        <button
          type="button"
          class="boring-btn"
          data-theme-switch
          title="Switch to light mode">Boring Mode</button
        >
      </div>

      <header class="topbar">
        <a class="brand" href="/">{SITE.handle}</a>
        <nav class="nav-links" aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            title="Toggle theme (light ⇄ terminal)"
          >
            <svg
              class="icon-moon"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              class="icon-sun"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
              ></path>
            </svg>
          </button>
        </nav>
      </header>

      <main>
        <slot />
        {/* live interactive shell (dark mode only) */}
        <div id="terminal" class="terminal-live term-only">
          <div id="term-out"></div>
          <form id="term-form" autocomplete="off">
            <span class="term-ps1"
              ><span class="usr">{SITE.handle}@web</span><span
                class="path term-cwd">:{termPath}</span
              ><span class="dollar">$</span></span
            >
            <span id="term-line" class="term-line-live" aria-hidden="true"
              ><span class="caret">&nbsp;</span></span
            >
            <input
              id="term-input"
              class="term-hidden-input"
              type="text"
              inputmode="text"
              enterkeyhint="go"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              aria-label="terminal command input"
            />
          </form>
        </div>
      </main>

      <footer class="site-footer">
        <span class="statusline term-only">
          <span class="mode">NORMAL</span>
          <span class="status-path">{termPath}</span>
          <span class="status-theme">theme=amber-crt</span>
          <span class="status-help-hint">? help</span>
        </span>
        <span class="doc-only">© {year} {SITE.name}</span>
        <span style="display:flex;gap:1.1rem;flex-wrap:wrap;align-items:baseline">
          {
            SOCIALS.map((s) => (
              <a href={s.href} rel="me noopener" target="_blank">
                {s.label}
              </a>
            ))
          }
          <button class="footer-help" data-help type="button" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">?</button>
        </span>
      </footer>
    </div>

    {/* keyboard shortcuts overlay */}
    <dialog id="help" class="help-dialog" aria-label="Keyboard shortcuts">
      <h2>Keyboard shortcuts</h2>
      <div class="help-grid">
        <kbd>t</kbd><span>toggle light / terminal</span>
        <kbd>g</kbd> <span>then <kbd>h</kbd> <kbd>w</kbd> <kbd>g</kbd> <kbd>b</kbd> — go home / work / gallery / writing</span>
        <kbd>1</kbd>–<kbd>4</kbd><span>jump to nav items</span>
        <kbd>j</kbd> / <kbd>k</kbd><span>move down / up (rows &amp; commits)</span>
        <kbd>↵</kbd><span>open photo · expand commit (git show)</span>
        <kbd>←</kbd> / <kbd>→</kbd><span>prev / next photo in viewer</span>
        <kbd>esc</kbd><span>close viewer / this dialog</span>
        <kbd>?</kbd><span>show this help</span>
      </div>
      <button class="help-close" type="button">close</button>
    </dialog>

    <script>
      import '../scripts/site.ts';
      import '../scripts/terminal.ts';
    </script>
  </body>
</html>
