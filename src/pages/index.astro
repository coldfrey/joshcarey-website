---
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { work } from '../data/work';
import { SITE, SOCIALS } from '../config';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const selectedWork = work.slice(0, 3);
---

<Base>
  {/* ---- whoami / hero ---- */}
  <section class="block">
    <Prompt cmd="whoami" class="term-only" />

    <div class="hero doc-only">
      <img
        class="avatar"
        src={SITE.avatar}
        alt="Joshua Carey"
        width="80"
        height="80"
        onerror={`this.onerror=null;this.src='${SITE.avatarFallback}'`}
      />
      <div>
        <h1>Hey, I’m Joshua 👋</h1>
        <p class="tagline">I build things on the web.</p>
      </div>
    </div>

    <p class="whoami term-only out">joshua carey — i build things on the web</p>
  </section>

  {/* ---- about ---- */}
  <section class="block">
    <Prompt cmd="cat about.txt" class="term-only" />
    <div class="intro out">
      <p>
        Welcome to my corner of the internet. I’m a software engineer who likes
        shipping clean, useful things — and occasionally writing about them.
      </p>
      <p>
        Take a look at my <a href="/work">work</a>, browse the
        <a href="/gallery">gallery</a>, or read the <a href="/blog">blog</a>.
      </p>
    </div>
  </section>

  {/* ---- ls (terminal-only directory listing) ---- */}
  <section class="block term-only">
    <Prompt cmd="ls" />
    <ul class="dir-list out">
      <li><a href="/work">work/</a></li>
      <li><a href="/gallery">gallery/</a></li>
      <li><a href="/blog">blog/</a></li>
      <li><span class="dir-file">about.txt</span></li>
    </ul>
  </section>

  {/* ---- socials ---- */}
  <section class="block">
    <Prompt cmd="cat ~/.contacts" class="term-only" />
    <div class="socials out">
      {
        SOCIALS.map((s) => (
          <a href={s.href} rel="me noopener" target="_blank">
            {s.label}
          </a>
        ))
      }
    </div>
  </section>

  {/* ---- recent writing + selected work (light only) ---- */}
  <div class="home-grid doc-only">
    <section>
      <p class="eyebrow">Writing</p>
      <ul class="mini-list">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <span class="mini-title">{post.data.title}</span>
                <time class="mini-date">{fmt(post.data.date)}</time>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="more-link" href="/blog">All writing →</a>
    </section>

    <section>
      <p class="eyebrow">Selected work</p>
      <ul class="mini-list">
        {
          selectedWork.map((item) => (
            <li>
              <a
                href={item.href && item.href !== '#' ? item.href : '/work'}
                target={item.href && item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href && item.href.startsWith('http') ? 'noopener' : undefined}
              >
                <span class="mini-title">{item.title}</span>
                <time class="mini-date">{item.date}</time>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="more-link" href="/work">All work →</a>
    </section>
  </div>
</Base>
