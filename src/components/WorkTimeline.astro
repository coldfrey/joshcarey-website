---
import Prompt from './Prompt.astro';
import TimelineCard from './TimelineCard.astro';
import { work, commitHash, commitType, branchRef, side, type WorkItem, type WorkLink } from '../data/work';

// git decorations like (HEAD -> main, tag: v1.0)
function decorations(item: WorkItem): string[] {
  const refs: string[] = [];
  if (item.status === 'active' && (item.kind ?? 'work') === 'work') refs.push('HEAD -> main');
  const branch = branchRef(item);
  if (branch) refs.push(branch);
  if (item.tag) refs.push(`tag: ${item.tag}`);
  return refs;
}

function refClass(r: string): string {
  if (r.startsWith('tag:')) return 'ref-tag';
  if (r.startsWith('HEAD')) return 'ref-head';
  if (r.startsWith('proj/')) return 'ref-proj';
  if (r.startsWith('life/')) return 'ref-life';
  return 'ref-branch';
}

const isExternal = (href: string) => /^https?:/.test(href);

// Light-mode rows: a `pair: true` item shares a row with the previous entry
// (one card each side of the spine). Everything else gets its own row.
const rows: WorkItem[][] = [];
for (const item of work) {
  const prev = rows[rows.length - 1];
  if (item.pair && prev?.length === 1 && side(prev[0]) !== side(item)) prev.push(item);
  else rows.push([item]);
}
const rowSide = (row: WorkItem[]) => (row.length === 2 ? 'both' : side(row[0]));

// Mobile segmented view: two self-contained lists, one per lane.
const workItems = work.filter((it) => side(it) === 'left');
const projItems = work.filter((it) => side(it) === 'right');

// title link + extra links, deduped, for the light links row and dark git show
function allLinks(item: WorkItem): WorkLink[] {
  const links: WorkLink[] = [];
  if (item.href) links.push({ label: 'site', href: item.href });
  for (const l of item.links ?? []) {
    if (!links.some((x) => x.href === l.href)) links.push(l);
  }
  return links;
}
---

{/* ============ LIGHT (wide): two-lane editorial timeline ============ */}
<div class="tl-lanehead doc-only" aria-hidden="true">
  <span>Work</span>
  <span></span>
  <span>Projects</span>
</div>
<div class="tl-scene doc-only">
<div class="tl-pac" aria-hidden="true">
  <span class="tl-pac-jaw tl-pac-jaw-top"></span>
  <span class="tl-pac-jaw tl-pac-jaw-bottom"></span>
</div>
<ol class="timeline" aria-label="Work and projects timeline">
  {
    rows.map((row, i) => (
      <li
        class="tl-entry"
        data-side={rowSide(row)}
        data-kind={row[0].kind ?? 'work'}
        style={`--i:${i}`}
      >
        {(i === 0 || rows[i - 1][0].date !== row[0].date) && (
          <span class="tl-yearmark" aria-hidden="true">{row[0].date}</span>
        )}
        <div class="tl-rail">
          <span class="tl-dot" data-status={row[0].status} data-kind={row[0].kind ?? 'work'} />
        </div>
        {row.map((item) => (
          <TimelineCard item={item} />
        ))}
      </li>
    ))
  }
</ol>
</div>

{/* ============ LIGHT (narrow): segmented Work / Projects view ============ */}
<div class="tl-mobile doc-only">
  <div class="tl-pac" aria-hidden="true">
    <span class="tl-pac-jaw tl-pac-jaw-top"></span>
    <span class="tl-pac-jaw tl-pac-jaw-bottom"></span>
  </div>
  <div class="tl-tabs" role="tablist" aria-label="Timeline category" data-active="work">
    <button
      type="button"
      class="tl-tab"
      role="tab"
      data-tab="work"
      id="tl-tab-work"
      aria-controls="tl-panel-work"
      aria-selected="true"
    >
      <span class="tl-tab-mark" data-cat="work" aria-hidden="true"></span>Work
    </button>
    <button
      type="button"
      class="tl-tab"
      role="tab"
      data-tab="projects"
      id="tl-tab-projects"
      aria-controls="tl-panel-projects"
      aria-selected="false"
      tabindex="-1"
    >
      <span class="tl-tab-mark" data-cat="side" aria-hidden="true"></span>Projects
    </button>
    <span class="tl-tab-glider" aria-hidden="true"></span>
  </div>

  <ol
    class="tl-mlist"
    data-tab="work"
    id="tl-panel-work"
    role="tabpanel"
    aria-labelledby="tl-tab-work"
  >
    {
      workItems.map((item, i) => (
        <li class="tl-entry" data-side="left" data-kind={item.kind ?? 'work'} style={`--i:${i}`}>
          <div class="tl-rail">
            <span class="tl-dot" data-status={item.status} data-kind={item.kind ?? 'work'} />
          </div>
          <TimelineCard item={item} />
        </li>
      ))
    }
  </ol>

  <ol
    class="tl-mlist"
    data-tab="projects"
    id="tl-panel-projects"
    role="tabpanel"
    aria-labelledby="tl-tab-projects"
    hidden
  >
    {
      projItems.map((item, i) => (
        <li class="tl-entry" data-side="right" data-kind={item.kind ?? 'work'} style={`--i:${i}`}>
          <div class="tl-rail">
            <span class="tl-dot" data-status={item.status} data-kind={item.kind ?? 'work'} />
          </div>
          <TimelineCard item={item} />
        </li>
      ))
    }
  </ol>
</div>

{/* ============ DARK: git log --oneline ============ */}
<div class="gitlog term-only">
  <Prompt cmd="git log --oneline --decorate" path="~/timeline" />
  <div class="gitlog-body" role="list">
    {
      work.map((item, i) => {
        const refs = decorations(item);
        const hash = commitHash(item.title + item.date);
        const links = allLinks(item);
        return (
          <div
            class="commit"
            role="listitem"
            tabindex="0"
            data-i={i}
            data-hash={hash}
          >
            <div class="commit-line">
              <span class="graph">*</span>
              <span class="hash">{hash}</span>
              {refs.length > 0 && (
                <span class="decorate">({refs.map((r, j) => (
                  <span class={refClass(r)}>{j > 0 ? ', ' : ''}{r}</span>
                ))})</span>
              )}
              <span class="subject">
                <span class={`ctype ctype-${commitType(item)}`}>{commitType(item)}:</span> {item.title}
              </span>
            </div>
            <div class="commit-body">
              <p class="cb-line">
                <span class="graph">│</span>
                <span class="cb-text">{item.description}</span>
              </p>
              {item.stack && (
                <p class="cb-line">
                  <span class="graph">│</span>
                  <span class="cb-meta">stack: {item.stack.join(', ')}</span>
                </p>
              )}
              <p class="cb-line cb-hint">
                <span class="graph">│</span>
                <span class="cb-meta">
                  {item.range ?? item.date} · press enter to `git show`
                </span>
              </p>
              <div class="commit-show" hidden>
                <p class="cb-line">
                  <span class="graph">│</span>
                  <span class="cb-meta">commit {hash}</span>
                </p>
                <p class="cb-line">
                  <span class="graph">│</span>
                  <span class="cb-meta">Author: Joshua Carey</span>
                </p>
                <p class="cb-line">
                  <span class="graph">│</span>
                  <span class="cb-meta">Date: {item.date}</span>
                </p>
                {item.highlights?.map((h) => (
                  <p class="cb-line">
                    <span class="graph">│</span>
                    <span class="cb-add">+ {h}</span>
                  </p>
                ))}
                {links.map((l) => (
                  <p class="cb-line">
                    <span class="graph">│</span>
                    {isExternal(l.href) ? (
                      <a class="cb-link" href={l.href} target="_blank" rel="noopener">
                        → {l.label}: {l.href}
                      </a>
                    ) : (
                      <a class="cb-link" href={l.href}>
                        → {l.label}: {l.href}
                      </a>
                    )}
                  </p>
                ))}
              </div>
            </div>
            <p class="cb-line cb-gap"><span class="graph">│</span></p>
          </div>
        );
      })
    }
  </div>
</div>
